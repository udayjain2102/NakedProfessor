# Copy to .env.local in this folder (never commit .env.local).
# Used by Vercel serverless: frontend/api/generate.js
OPENAI_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=
VITE_AUTH_REDIRECT_URL=
VITE_ADSENSE_SLOT_TOP_BANNER=
VITE_PROFESSOR_ARTIFACT_PATHS=
VITE_TOP_COLLEGES_PATH=
VITE_WEB_VITALS_ENDPOINT=

# Local/CI-only upload credentials for `npm run upload:professor-data`.
# Never expose SUPABASE_SERVICE_ROLE_KEY to browser code or commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROFESSOR_BUCKET=professor-artifacts
SUPABASE_PROFESSOR_OBJECT=top200_plus_behrend_professors.csv
PROFESSOR_ARTIFACT_SOURCE=public/data/top200_plus_behrend_professors.csv
